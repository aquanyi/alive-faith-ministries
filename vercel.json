{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "redirects": [
    { "source": "/about(.*)", "destination": "/#about", "permanent": true },
    { "source": "/contact(.*)", "destination": "/#contact", "permanent": true },
    { "source": "/give(.*)", "destination": "/#giving", "permanent": true },
    { "source": "/sermons(.*)", "destination": "/#watch", "permanent": true },
    { "source": "/events(.*)", "destination": "/#home", "permanent": true },
    { "source": "/ministries(.*)", "destination": "/#about", "permanent": true }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.(ico|png)", "destination": "/favicon.$1" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
